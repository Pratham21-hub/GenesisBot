# ==============================================================================
# GenesisBot V2 - Environment Configuration Example
# Copy this file to `.env` and fill in local values.
# NEVER commit the actual `.env` file containing secrets to version control.
# ==============================================================================

# Application Environment (development, testing, production)
GENESIS_ENV=development

# Bot Identification
GENESIS_BOT_NAME=GenesisBot
GENESIS_BOT_VERSION=2.0.0

# Official Competition API Integration (Placeholders - to be filled when hackathon specs are published)
# DO NOT place real tokens or keys in this example file.
GENESIS_API_BASE_URL=https://api.placeholder-competition.org/v1
GENESIS_API_KEY=placeholder_api_key_replace_in_env
GENESIS_SESSION_ID=placeholder_session_id

# Network and Polling Configuration
GENESIS_POLL_INTERVAL_SEC=1.0
GENESIS_REQUEST_TIMEOUT_SEC=5.0
GENESIS_MAX_RETRIES=3

# Logging Configuration (Standard-library JSONL logging)
GENESIS_LOG_LEVEL=INFO
GENESIS_LOG_FILE=logs/bot_audit.jsonl
